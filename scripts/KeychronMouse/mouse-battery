#!/usr/bin/env bash
# Keychron M6 Wireless battery checker wrapper

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
VENV="$SCRIPT_DIR/../scriptsEnv/.venv/bin/python"

HIDAPI_SYSTEM="/run/current-system/sw/lib"
HIDAPI_LIB="$HIDAPI_SYSTEM"

if ! ls "$HIDAPI_LIB"/libhidapi-hidraw.so* 1> /dev/null 2>&1; then
    echo "Error: libhidapi not found in $HIDAPI_LIB" >&2
    exit 1
fi

export LD_LIBRARY_PATH="$HIDAPI_LIB"
exec "$VENV" "$SCRIPT_DIR/MouseBattery.py" "$@"
