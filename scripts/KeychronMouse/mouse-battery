#!/usr/bin/env bash
# Keychron M6 Mouse Battery Monitor daemon wrapper

if pgrep -x "peripherial_mon" >/dev/null || pgrep -x "peripherial_monitor" >/dev/null; then
    exit 0
fi

if command -v peripherial_monitor >/dev/null 2>&1; then
    exec peripherial_monitor "$@"
fi

DAEMON_BIN="/home/doni/nixos-config/nix_files/rust_daemons/peripherial_monitor/target/release/peripherial_monitor"
if [[ -x "$DAEMON_BIN" ]]; then
    exec "$DAEMON_BIN" "$@"
fi
