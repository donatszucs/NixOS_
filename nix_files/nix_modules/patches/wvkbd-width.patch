 }
 
+void
+drw_draw_shadow(struct drwsurf *ds, uint32_t x, uint32_t y,
+                uint32_t w, uint32_t h, int rounding,
+                int blur, int offset_y, double max_alpha)
+{
+    drwsurf_flip(ds);
+    struct drwbuf *d = ds->back_buffer;
+    drwsurf_damage(ds, 0, 0, ds->width, ds->height);
+
+    cairo_save(d->cairo);
+    cairo_set_operator(d->cairo, CAIRO_OPERATOR_OVER);
+    cairo_set_antialias(d->cairo, CAIRO_ANTIALIAS_DEFAULT);
+
+    double degrees = M_PI / 180.0;
+    int steps = blur;
+    for (int i = steps; i >= 1; i--) {
+        double factor = (double)(steps - i + 1) / (double)steps;
+        double alpha = max_alpha * factor * factor / (double)steps * 2.2;
+        if (alpha > 1.0) alpha = 1.0;
+
+        double r = rounding + i;
+        double sx = (double)x - i;
+        double sy = (double)y - i + offset_y;
+        double sw = (double)w + 2 * i;
+        double sh = (double)h + 2 * i;
+
+        cairo_new_sub_path(d->cairo);
+        cairo_arc(d->cairo, sx + sw - r, sy + r, r, -90 * degrees, 0 * degrees);
+        cairo_arc(d->cairo, sx + sw - r, sy + sh - r, r, 0 * degrees, 90 * degrees);
+        cairo_arc(d->cairo, sx + r, sy + sh - r, r, 90 * degrees, 180 * degrees);
+        cairo_arc(d->cairo, sx + r, sy + r, r, 180 * degrees, 270 * degrees);
+        cairo_close_path(d->cairo);
+
+        cairo_set_source_rgba(d->cairo, 0.0, 0.0, 0.0, alpha);
+        cairo_fill(d->cairo);
+    }
+
+    cairo_restore(d->cairo);
+}
